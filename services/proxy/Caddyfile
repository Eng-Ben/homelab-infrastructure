# Routes requests from Tailscale Serve to the services and adds security headers.
# Speaks plain HTTP only, because TLS is terminated before traffic reaches Caddy.

{
	# TLS is terminated by Tailscale (later also Cloudflare), so Caddy only speaks plain HTTP.
	auto_https off
}

:80 {
	log

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy test-site:80
}